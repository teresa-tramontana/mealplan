// Cloudflare Worker: liefert die fertige App (index.html, Bilder, Icons) aus
// hinter einer PIN-Sperre und speichert unter /api/state die gemeinsamen Daten der Familie (worker.js).
{
  "name": "familientisch",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "FAMILIE", "class_name": "Familie" },
      { "name": "PINSPERRE", "class_name": "PinSperre" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Familie"] },
    { "tag": "v2", "new_sqlite_classes": ["PinSperre"] }
  ]
}
